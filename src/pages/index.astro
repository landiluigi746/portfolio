---
import { featuredProjects } from "../data/products";
import PageLayout from "../layouts/PageLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<PageLayout title="Luigi Landi's Portoflio">
    <div class="h-[92svh] flex flex-col items-center justify-center gap-6">
        <h1 class="text-zinc-100 font-extrabold text-7xl">
            Hi, I'm Luigi Landi.
        </h1>
        <p class="text-zinc-600 font-semibold">
            Computer Science Student • C/C++ & Web Developer
        </p>
        <div class="flex flex-row items-center gap-x-6">
            <a
                href="/portfolio/projects"
                class="text-zinc-100 font-medium px-6 py-3.5 rounded-lg border border-zinc-600 bg-neutral-950 transition-all duration-500 hover:text-zinc-950 hover:bg-zinc-100"
            >
                View Projects
            </a>
            <a
                href="/portfolio/experience"
                class="text-zinc-100 font-medium px-6 py-3.5 rounded-lg border border-zinc-600 bg-neutral-950 transition-all duration-500 hover:text-zinc-950 hover:bg-zinc-100"
            >
                View Experience
            </a>
        </div>
    </div>
    <div class="w-full flex flex-col items-start gap-6">
        <div class="w-full flex flex-row items-center justify-between">
            <h2 class="text-zinc-100 font-bold text-3xl">Top projects</h2>
            <a
                href="/portfolio/projects"
                class="text-zinc-100 font-medium px-3 py-1.5 rounded-lg border border-zinc-600 bg-neutral-950 transition-all duration-500 hover:text-zinc-950 hover:bg-zinc-100"
            >
                View all
            </a>
        </div>
        <div class="grid grid-cols-3 gap-x-6">
            {featuredProjects.map((project) => (
                <ProjectCard project={project} />
            ))}
        </div>
    </div>
</PageLayout>
