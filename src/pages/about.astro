---
import EducationCard from "../components/EducationCard.astro";
import TechStackCard from "../components/TechStackCard.astro";
import { education } from "../data/education";
import { techStack } from "../data/tech_stack";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="About - Luigi Landi">
    <div class="w-full flex flex-col items-start gap-y-12 my-12">
        <div class="flex flex-col gap-y-6 items-start">
            <h1 class="text-zinc-100 text-4xl font-extrabold">About me</h1>
            <p class="text-zinc-100 text-justify">
                I'm an italian 1st year computer science student at University
                of Salerno and aspiring programmer with a passion for problem
                solving, learning, and building. I enjoy experimenting with
                different technologies and creating a wide variety of
                projects—both independently and as part of a team. Lately, also
                thanks to my experiences in the 2025 edition of
                CyberChallenge.IT and the 2026 edition of OliCyber.IT (check out{" "}
                <a
                    href="/portoflio/experience"
                    class="text-amber-300 hover:underline"
                >
                    Experience
                </a>{" "}
                for more details), my main interests revolve around web
                development, CLI tool development, self hosting, infrastructure
                management and software security.
            </p>
        </div>
        <div class="w-full flex flex-col gap-y-6 items-start">
            <h2 class="text-zinc-100 text-3xl font-extrabold">Education</h2>
            <div class="w-full flex flex-col items-start border-y border-y-zinc-600">
                {education.map((educationItem) => (
                    <EducationCard education={educationItem} />
                ))}
            </div>
        </div>
        <div class="w-full flex flex-col gap-y-6 items-start">
            <h2 class="text-zinc-100 text-3xl font-extrabold">My Tech Stack</h2>
            <p class="text-zinc-100 text-justify">
                During my developer journey (~2.5 years), I came across several
                technologies in order to develop my projects, and I'm always
                open to trying new workflows. These are just some of the
                technologies I like to work with.
            </p>
            <div class="w-full grid grid-cols-4 justify-start items-center gap-x-2 gap-y-2">
                {techStack.map((techStackItem) => (
                    <TechStackCard techStackItem={techStackItem} />
                ))}
            </div>
        </div>
    </div>
</PageLayout>
