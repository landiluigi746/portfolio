---
import type { EducationProps } from "../data/education";

interface Props {
    education: EducationProps;
}

const { education } = Astro.props;
---

<div class="w-full flex flex-col items-start gap-y-2 rounded-lg px-3 py-2 my-2 transition-all duration-500 hover:bg-zinc-900">
    <h3 class="text-zinc-100 text-xl font-semibold">{education.place}</h3>
    <p class="text-zinc-500 text-sm">
        {education.yearBegin} - {education.yearEnd ?? "Current"}
    </p>
</div>
