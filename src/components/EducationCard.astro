---
import type { EducationProps } from "../data/education";

interface Props {
    education: EducationProps;
}

const { education } = Astro.props;
---

<div class="w-full flex flex-col items-start gap-y-2 rounded-lg my-2 transition-all duration-500 hover:bg-zinc-900 md:px-3 md:py-2">
    <h3 class="text-zinc-100 text-lg font-semibold md:text-xl">
        {education.place}
    </h3>
    <p class="text-zinc-500 text-sm">
        {education.yearBegin} - {education.yearEnd ?? "Current"}
    </p>
</div>
