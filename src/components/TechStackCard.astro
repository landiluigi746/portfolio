---
import { ICONS_URL, type TechStackItem } from "../data/tech_stack";

interface Props {
    techStackItem: TechStackItem;
}

const { techStackItem } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-y-2 px-3 py-3 rounded-lg border border-zinc-800 bg-neutral-950 transition-all duration-500 hover:bg-neutral-900">
    <img
        src={ICONS_URL + "?i=" + techStackItem.iconName}
        class="w-8 h-8 rounded-lg"
    />
    <p class="text-zinc-100 font-medium text-nowrap">{techStackItem.name}</p>
</div>
