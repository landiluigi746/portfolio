---
const pages: string[] = ["about", "projects", "experience"];

import profilePicture from "../assets/img/profile_picture.jpeg";
import { Image } from "astro:assets";
---

<script>
    function setupSidebar() {
        const sidebarToggle = document.getElementById("sidebar-toggle");
        const sidebar = document.getElementById("sidebar");

        sidebarToggle?.addEventListener("click", () => {
            sidebar?.classList.toggle("translate-x-full");
            sidebar?.classList.toggle("opacity-0");
        });

        const sidebarLinks = sidebar?.querySelectorAll("a");
        sidebarLinks?.forEach((link) => {
            if (window.location.pathname == link.getAttribute("href")) {
                link.classList.add("outline", "outline-zinc-500");
            }
            link.addEventListener("click", () => {
                sidebar?.classList.add("translate-x-full", "opacity-0");
            });
        });
    }

    document.addEventListener("astro:page-load", setupSidebar);
</script>

<nav class="z-1 sticky top-0 left-0 py-4 border-b border-b-zinc-800 bg-neutral-950 overflow-x-hidden">
    <div class="w-[90svw] flex flex-row items-center justify-between mx-auto lg:w-[70svw]">
        <div class="flex flex-row items-center gap-x-2">
            <Image
                src={profilePicture}
                alt="Profile picture"
                width="32"
                height="32"
                class="rounded-full"
            />
            <a href="/portfolio" class="text-zinc-100 text-xl font-bold">
                Luigi Landi
            </a>
        </div>
        <button
            id="sidebar-toggle"
            class="text-zinc-100 text-2xl hover:cursor-pointer md:hidden"
        >
            ☰
        </button>
        <div
            id="sidebar"
            class="w-svw h-svh z-2 fixed top-16 right-0 opacity-0 flex flex-col items-end gap-y-3 translate-x-full pr-2 bg-zinc-950/90 transition-all duration-500 md:w-max md:h-full md:static md:opacity-100 md:p-0 md:bg-transparent md:flex-row md:items-center md:gap-x-2 md:translate-x-0"
        >
            <a
                href={`/portfolio/`}
                class="text-zinc-100 px-3 py-2 rounded-lg transition-all duration-500 hover:bg-neutral-900 hover:cursor-pointer"
            >
                Home
            </a>
            {pages.map((page) => (
                <a
                    href={`/portfolio/${page}`}
                    class="capitalize text-zinc-100 px-3 py-2 rounded-lg transition-all duration-500 hover:bg-neutral-900 hover:cursor-pointer"
                >
                    {page}
                </a>
            ))}
            <a
                href={`/portfolio/contact`}
                class="text-zinc-950 px-3 py-2 rounded-lg border border-zinc-800 bg-zinc-100 transition-all duration-500 hover:text-zinc-100 hover:bg-neutral-900 hover:cursor-pointer"
            >
                Get in touch
            </a>
        </div>
    </div>
</nav>
