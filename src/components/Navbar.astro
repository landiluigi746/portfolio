---
import { pages } from "../data";
import profilePicture from "../assets/img/profile_picture.jpeg";
import { Image } from "astro:assets";
---

<nav
    class="z-1 sticky top-0 left-0 py-4 border-b border-b-zinc-800 bg-neutral-950"
>
    <div class="w-[70svw] flex flex-row items-center justify-between mx-auto">
        <div class="flex flex-row items-center gap-x-2">
            <Image
                src={profilePicture}
                alt="Profile picture"
                width="32"
                height="32"
                class="rounded-full"
            />
            <a href="/portfolio" class="text-zinc-100 text-xl font-bold">
                Luigi Landi
            </a>
        </div>
        <div class="flex flex-row items-center gap-x-2">
            {
                pages.map((item) => (
                    <a
                        href={`/portfolio/${item}`}
                        class="text-zinc-100 px-3.5 py-2 rounded-2xl hover:cursor-pointer hover:bg-neutral-900 not-lg:text-xs transition-all capitalize"
                    >
                        {item}
                    </a>
                ))
            }
        </div>
    </div>
</nav>
