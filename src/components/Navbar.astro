---
const pages: string[] = [
    "about",
    "skills",
    "projects",
    "experience",
    "contacts",
];

import profilePicture from "../assets/img/profile_picture.jpeg";
import { Image } from "astro:assets";
---

<nav class="z-1 sticky top-0 left-0 py-4 border-b border-b-zinc-800 bg-neutral-950">
    <div class="w-[70svw] flex flex-row items-center justify-between mx-auto">
        <div class="flex flex-row items-center gap-x-2">
            <Image
                src={profilePicture}
                alt="Profile picture"
                width="32"
                height="32"
                class="rounded-full"
            />
            <a href="/portfolio" class="text-zinc-100 text-xl font-bold">
                Luigi Landi
            </a>
        </div>
        <div class="flex flex-row items-center gap-x-2">
            <a
                href={`/portfolio/`}
                class="text-zinc-100 px-3 py-2 rounded-lg hover:cursor-pointer hover:bg-neutral-900 not-lg:text-xs transition-all capitalize"
            >
                Home
            </a>
            {pages.map((page) => (
                <a
                    href={`/portfolio/${page}`}
                    class="text-zinc-100 px-3 py-2 rounded-lg hover:cursor-pointer hover:bg-neutral-900 not-lg:text-xs transition-all capitalize"
                >
                    {page}
                </a>
            ))}
        </div>
    </div>
</nav>
