---
import type { ProjectProps } from "../data/projects";

interface Props {
    project: ProjectProps;
}

const { project } = Astro.props;
---

<div class="flex flex-col gap-y-2 rounded-lg border border-zinc-800 bg-neutral-950 transition-all duration-500 hover:bg-neutral-900 hover:-translate-y-2">
    <img
        src={project.imageURL}
        alt={project.name}
        class="h-64 aspect-auto object-cover rounded-t-lg border-b border-zinc-800"
    />
    <div class="flex flex-col gap-y-2 px-2 py-2">
        <h3 class="text-zinc-100 font-semibold">{project.name}</h3>
        <p class="text-zinc-400 text-sm">{project.description}</p>
        <div class="flex flex-row items-center gap-x-2">
            {project.tags.map((tag) => (
                <p class="text-zinc-100 text-xs px-1.5 py-1 rounded-lg border border-zinc-800 bg-neutral-800">
                    {tag}
                </p>
            ))}
        </div>
        <div class="flex flex-row items-center gap-x-2">
            {project.githubLink && (
                <a
                    href={project.githubLink}
                    target="_blank"
                    class="text-zinc-100 font-medium px-3.5 py-2 rounded-lg border border-zinc-800 transition-all duration-500 hover:text-zinc-950 hover:bg-zinc-100"
                >
                    Github
                </a>
            )}

            {project.websiteLink && (
                <a
                    href={project.websiteLink}
                    target="_blank"
                    class="text-zinc-100 font-medium px-3.5 py-2 rounded-lg border border-zinc-800 transition-all duration-500 hover:text-zinc-950 hover:bg-zinc-100"
                >
                    🌐 Live
                </a>
            )}
        </div>
    </div>
</div>
