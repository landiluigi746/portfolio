---
import { contacts, ICONS_URL } from "../data";
---

<div id="contacts" class="pb-8">
    <h2 class="font-extrabold text-zinc-100 text-center text-4xl pb-8">
        You can find me on
    </h2>
    <div class="flex flex-row justify-center items-center gap-4">
        {
            contacts.map((contact) => (
                <a href={contact.link}>
                    <img src={ICONS_URL + "?i=" + contact.name} />
                </a>
            ))
        }
    </div>
</div>
