---
import { techStack, ICONS_URL } from "../data";
---

<div id="tech-stack" class="text-zinc-100 max-w-1/3 mx-auto not-xl:max-w-4/5">
    <h2 class="font-extrabold text-4xl text-center">My Tech Stack</h2>
    <div
        class="flex flex-nowrap py-16 overflow-hidden mask-[linear-gradient(to_right,transparent_0,black_128px,black_calc(100%-200px),transparent_100%)]"
    >
        <div
            class="flex justify-center items-center md:justify-start [&_img]:mx-8 [&_img]:max-w-none infinite-scroll"
        >
            {techStack.map((elem) => <img src={ICONS_URL + "?i=" + elem} />)}
        </div>

        <div
            class="flex justify-center items-center md:justify-start [&_img]:mx-8 [&_img]:max-w-none infinite-scroll"
        >
            {techStack.map((elem) => <img src={ICONS_URL + "?i=" + elem} />)}
        </div>
    </div>
</div>
