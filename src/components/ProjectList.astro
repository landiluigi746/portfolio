---
import { projects } from "../data";
import ProjectCard from "./ProjectCard.astro";
---

<div id="projects">
    <h2 class="font-extrabold text-zinc-100 text-center text-4xl pt-8 pb-8">
        My top projects
    </h2>

    <div
        class="w-max mx-auto grid grid-cols-1 xl:grid-cols-3 gap-8 not-sm:gap-0"
    >
        {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    <h4 class="font-extrabold text-zinc-100 text-center my-12">
        Many more coming soon!
    </h4>
</div>
