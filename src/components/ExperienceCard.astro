---
import type { ExperienceProps } from "../data/experiences";

interface Props {
    experience: ExperienceProps;
}

const { experience } = Astro.props;
---

<div class="flex flex-col items-start gap-y-2 rounded-lg my-4 transition-all duration-500 hover:bg-zinc-900 hover:-translate-y-2 md:px-3 md:py-2">
    <h3 class="text-zinc-100 text-xl font-semibold md:text-2xl">
        {experience.name}
    </h3>
    <p class="text-zinc-500 text-sm">
        {experience.year} •{" "}
        <span class="text-amber-300">{experience.position}</span>
    </p>
    <p class="text-zinc-100 text-sm">{experience.description}</p>
</div>
